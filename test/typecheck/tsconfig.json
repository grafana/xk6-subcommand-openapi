// Type-checks the generated client libraries in ../testdata and the assertions in *.check.ts; see `make typecheck`.
{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2022"],
    "module": "preserve",
    "allowImportingTsExtensions": true,
    // The client libraries are outside this directory, so they would not find node_modules/@types/k6 on their own.
    "paths": { "k6/*": ["./node_modules/@types/k6/*"] }
  },
  "include": ["jslib.d.ts", "*.check.ts", "../testdata/**/*_client.ts"]
}
