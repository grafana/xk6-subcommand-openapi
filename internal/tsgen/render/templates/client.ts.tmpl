  /**
   * Builds a multipart body with one part per field and array element, omitting undefined and null:
   * FileData as it is, ArrayBuffer as a file, other objects as JSON, and everything else as a string.
   */
  private _formData(values: unknown) {
    const formData = new FormData();
    for (const [name, value] of Object.entries((values ?? {}) as Record<string, unknown>)) {
      for (const item of Array.isArray(value) ? value : [value]) {
        if (item === undefined || item === null) {
          continue;
        }
        if (item instanceof ArrayBuffer) {
          formData.append(name, http.file(item));
        } else if (typeof item === "object" && "data" in item && "filename" in item) {
          formData.append(name, item);
        } else if (typeof item === "object") {
          formData.append(name, JSON.stringify(item));
        } else {
          formData.append(name, String(item));
        }
      }
    }
    return formData;
  }
{{- end }}
{{- if .Features.Methods }}

  /** Merges commonK6Params with k6Params and then headers, key by key for headers, cookies, and tags. */
  private _mergeK6Params(k6Params: Params | undefined, headers: Record<string, string>): Params {
    const common = this.commonK6Params;
    return {
      ...common,
      ...k6Params,
      headers: { ...common.headers, ...k6Params?.headers, ...headers },
      cookies: { ...common.cookies, ...k6Params?.cookies },
      tags: { ...common.tags, ...k6Params?.tags },
    };
  }

  /** Decodes the response body by its Content-Type: JSON is parsed, anything else is returned unchanged. */
  private _decodeBody(response: Response): unknown {
    const body = response.body;
    if (body === null || body === undefined || body === "" || (body instanceof ArrayBuffer && body.byteLength === 0)) {
      return undefined;
    }
    const mediaType = (response.headers["Content-Type"] ?? "").split(";")[0].trim().toLowerCase();
    if (mediaType === "application/json" || mediaType.endsWith("+json")) {
      return response.json();
    }
    return body;
  }
